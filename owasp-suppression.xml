<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        FALSE POSITIVE — CVE-2023-0440
        ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        The NVD entry for CVE-2023-0440 describes an Observable Discrepancy vulnerability
        in the open-source Django-based cron-monitoring web application at
        https://github.com/healthchecks/healthchecks (prior to v2.6).

        OWASP Dependency-Check incorrectly matches this CVE to the NuGet package
        "Microsoft.Extensions.Diagnostics.HealthChecks" because both contain the string
        "healthchecks", leading the CPE algorithm to resolve
        cpe:2.3:a:healthchecks:healthchecks:* against Microsoft's ASP.NET Core library.

        Microsoft.Extensions.Diagnostics.HealthChecks is a .NET runtime library for
        adding health-check endpoints to ASP.NET Core applications. It shares no code,
        maintainer, or vulnerability surface with the Django healthchecks.io project.

        Resolution: suppress this false-positive match permanently.
        Last reviewed: 2026-06-16
    -->
    <suppress>
        <notes><![CDATA[
            FALSE POSITIVE: CVE-2023-0440 affects the Django-based healthchecks.io web
            application (github.com/healthchecks/healthchecks), not Microsoft's ASP.NET
            Core health-check library. CPE string-matching incorrectly links the two.
        ]]></notes>
        <packageUrl regex="true">^pkg:nuget/Microsoft\.Extensions\.Diagnostics\.HealthChecks@.*$</packageUrl>
        <cve>CVE-2023-0440</cve>
    </suppress>

</suppressions>
