<?xml version="1.0" encoding="utf-8"?>

<configuration>
    <packageSources>
        <!-- Public nuget.org first -->
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!-- GitHub Packages for ThunderPropagator organization -->
        <add key="github" value="https://nuget.pkg.github.com/KiarashMinoo/index.json" />
    </packageSources>

    <!-- Package source mapping for enhanced security -->
    <packageSourceMapping>
        <packageSource key="github">
            <package pattern="ThunderPropagator.*" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>