<?xml version="1.0" encoding="utf-8"?>

<configuration>
    <packageSources>
        <!-- Public nuget.org first -->
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!-- GitHub Packages for ThunderPropagator (Project ARC) organization -->
        <add key="github" value="https://nuget.pkg.github.com/KiarashMinoo/index.json" />
    </packageSources>

    <!-- Authentication credentials - Use environment variables or user-level config for security -->
    <packageSourceCredentials>
        <github>
            <add key="Username" value="KiarashMinoo" />
            <!-- Use environment variable GITHUB_TOKEN or configure in user-level NuGet.config -->
            <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
        </github>
    </packageSourceCredentials>

    <!-- Package source mapping for enhanced security -->
    <packageSourceMapping>
        <packageSource key="github">
            <package pattern="ThunderPropagator.*" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>