<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <Configurations>Debug;Release</Configurations>
        <LangVersion>latestmajor</LangVersion>
        <Platforms>AnyCPU;x86;x64</Platforms>
        <Version>1.0.54.0</Version>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <DebugSymbols>False</DebugSymbols>
        <DebugType>None</DebugType>
        <DefineConstants/>
    </PropertyGroup>

    <PropertyGroup Label="nuget">
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Authors>RapidStreamer</Authors>
        <Description>Redefining real time data streaming; effortless, blazingly fast and cloud-native for maximum impact</Description>
        <Copyright>Copyright ©2024 RapidStreamer Corporation</Copyright>
        <PackageProjectUrl>https://www.rapidstreamer.com</PackageProjectUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/KAB-TEAM/RapidStreamer.BuildingBlocks</RepositoryUrl>
        <PackageTags>Real-Time Data Streaming, Blazingly Fast, Cloud-Native, Data Streaming, Effortless Performance, High Impact, Real-Time Processing, Fast Data Pipelines, Cloud Solutions, Streaming Technology</PackageTags>
        <PackageIcon>RapidStreamer.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <AvoidCycleErrorOnSelfReference>true</AvoidCycleErrorOnSelfReference>
    </PropertyGroup>

    <Choose>
        <When Condition="'$(Configuration)'=='Debug'">
            <Choose>
                <When Condition="'$(Platform)'=='x86'">
                    <PropertyGroup>
                        <PackageId>RapidStreamer.BuildingBlocks.Modules.Debug.x86</PackageId>
                    </PropertyGroup>
                </When>
                <When Condition="'$(Platform)'=='x64'">
                    <PropertyGroup>
                        <PackageId>RapidStreamer.BuildingBlocks.Modules.Debug.x64</PackageId>
                    </PropertyGroup>
                </When>
                <Otherwise>
                    <PropertyGroup>
                        <PackageId>RapidStreamer.BuildingBlocks.Modules.Debug</PackageId>
                    </PropertyGroup>
                </Otherwise>
            </Choose>
        </When>
        <Otherwise>
            <Choose>
                <When Condition="'$(Platform)'=='x86'">
                    <PropertyGroup>
                        <PackageId>RapidStreamer.BuildingBlocks.Modules.x86</PackageId>
                    </PropertyGroup>
                </When>
                <When Condition="'$(Platform)'=='x64'">
                    <PropertyGroup>
                        <PackageId>RapidStreamer.BuildingBlocks.Modules.x64</PackageId>
                    </PropertyGroup>
                </When>
                <Otherwise>
                    <PropertyGroup>
                        <PackageId>RapidStreamer.BuildingBlocks.Modules</PackageId>
                    </PropertyGroup>
                </Otherwise>
            </Choose>
        </Otherwise>
    </Choose>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Apache.NMS.ActiveMQ" Version="2.1.0"/>
        <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16"/>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.10"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\RapidStreamer.BuildingBlocks.Application\RapidStreamer.BuildingBlocks.Application.csproj"/>
    </ItemGroup>


    <ItemGroup>
        <None Include="..\..\RapidStreamer.png" Pack="true" Link="RapidStreamer.png" PackagePath=""/>
        <None Include="..\..\README.md" Pack="true" Link="README.md" PackagePath=""/>
    </ItemGroup>

</Project>
