<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup Label="PackageId">
        <!--
            Simplified PackageId construction:
            - Base: RapidStreamer.BuildingBlocks.Modules
            - If Configuration is Debug -> append .Debug
            - If Platform is not AnyCPU -> append .{Platform}
            This produces the same results as the previous conditional PackageId entries
            while being easier to read and maintain.
        -->
        <PackageIdBase>RapidStreamer.BuildingBlocks.Modules</PackageIdBase>
        <PackageIdConfigurationSuffix Condition="'$(Configuration)' == 'Debug'">.Debug</PackageIdConfigurationSuffix>
        <PackageIdPlatformSuffix Condition="'$(Platform)' != 'AnyCPU'">.$(Platform)</PackageIdPlatformSuffix>
        <PackageId>$(PackageIdBase)$(PackageIdConfigurationSuffix)$(PackageIdPlatformSuffix)</PackageId>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'" Label="Microsoft.Extensions">
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.*"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'" Label="Microsoft.Extensions">
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="9.*"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'" Label="Microsoft.Extensions">
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.*"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Apache.NMS.ActiveMQ" Version="2.1.1"/>
        <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.28"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\RapidStreamer.BuildingBlocks.Application\RapidStreamer.BuildingBlocks.Application.csproj"/>
    </ItemGroup>

</Project>
