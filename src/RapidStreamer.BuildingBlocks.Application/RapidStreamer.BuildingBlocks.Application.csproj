<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <Configurations>Debug;Release;Cluster</Configurations>
        <LangVersion>latestmajor</LangVersion>
        <Platforms>AnyCPU;ARM32;ARM64;x86;x64</Platforms>
        <Version>1.0.44.0</Version>
    </PropertyGroup>

    <PropertyGroup Label="nuget">
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>RapidStreamer.BuildingBlocks</PackageId>
        <Authors>RapidStreamer</Authors>
        <Description>Redefining real time data streaming; effortless, blazingly fast and cloud-native for maximum impact</Description>
        <Copyright>Copyright ©2024 RapidStreamer Corporation</Copyright>
        <PackageProjectUrl>https://www.rapidstreamer.com</PackageProjectUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/KAB-TEAM/RapidStreamer.BuildingBlocks</RepositoryUrl>
        <PackageTags>Real-Time Data Streaming, Blazingly Fast, Cloud-Native, Data Streaming, Effortless Performance, High Impact, Real-Time Processing, Fast Data Pipelines, Cloud Solutions, Streaming Technology</PackageTags>
        <PackageIcon>RapidStreamer.png</PackageIcon>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CaseConverter" Version="2.0.1"/>
        <PackageReference Include="JetBrains.Annotations" Version="2024.3.0"/>
        <PackageReference Include="MemoryPack" Version="1.21.3"/>
        <PackageReference Include="MessagePack" Version="2.5.187"/>
        <PackageReference Include="MessagePack.Annotations" Version="2.5.187"/>
        <PackageReference Include="MessagePackAnalyzer" Version="2.5.187">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.1.2"/>
        <PackageReference Include="NetJSON" Version="1.4.4"/>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
        <PackageReference Include="Newtonsoft.Json.Schema" Version="4.0.1"/>
        <PackageReference Include="protobuf-net" Version="3.2.45"/>
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.1.2"/>
        <PackageReference Include="System.Text.Json" Version="8.0.5"/>
        <PackageReference Include="YamlDotNet" Version="16.1.3"/>
        <PackageReference Include="NJsonSchema" Version="11.0.2"/>
        <PackageReference Include="Ardalis.GuardClauses" Version="5.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\RapidStreamer.png" Pack="true" Link="RapidStreamer.png" PackagePath=""/>
        <None Include="..\..\README.md" Pack="true" Link="README.md" PackagePath=""/>
    </ItemGroup>

</Project>
